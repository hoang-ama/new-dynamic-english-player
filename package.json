{
  "name": "dynamic-english-data-pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-data.mjs",
    "build:vercel": "npm run validate && node scripts/build-vercel.mjs",
    "dev": "node scripts/dev-server.mjs",
    "validate": "node scripts/validate-data.mjs",
    "extract": "node scripts/extract-source-lessons.mjs",
    "enrich": "node scripts/enrich-lessons.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "refresh": "npm run build && npm run validate"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "dotenv": "18.0.5"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.57.0"
  }
}
